DB_HOST=localhost
DB_PORT=5432
DB_NAME=talk_to_my_data_v2

# Read-write role: chat history and LangGraph checkpoints.
DB_USER=postgres
DB_PASSWORD=

# Read-only role: every query the model writes. See database/12_readonly_role.sql
# Leave blank in local development and the app falls back to DB_USER, still
# inside a read-only transaction.
DB_READONLY_USER=data_runtime_reader
DB_READONLY_PASSWORD=

DB_STATEMENT_TIMEOUT_MS=15000
DB_ROW_CAP=500
DB_POOL_MAX=8

# The model, and where to reach it. Any OpenAI-compatible endpoint works, so a
# provider withdrawing a model is a config change rather than a code change.
# Gemini 3.x thinking models fail on the second tool call through the OpenAI
# compatibility layer (a missing thought_signature); 2.5 predates that.
ZEN_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
ZEN_MODEL=gemini-2.5-flash-lite
ZEN_API_KEY=

# Encrypts connected databases' passwords at rest (src/db/secrets.py).
# Generate with: python -m src.db.secrets --new-key
CREDENTIAL_KEY=

# --- reconciliation pack (packs/recon) --------------------------------------
# The database the pack reconciles. Read by the pack's own machinery.
RECON_DSN=postgresql://apple@localhost:5432/kartly

# Applying a resolution needs this set explicitly. A process meant only to read
# and propose never holds it. In anything but local development this is a role
# with INSERT on `matches` and nothing else - not the owner.
# RECON_WRITE_DSN=
